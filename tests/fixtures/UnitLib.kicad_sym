(kicad_symbol_lib
	(version 20251024)
	(generator "test")
	(generator_version "10.0")
	(symbol "Quad"
		(pin_names (offset 1.016))
		(property "Reference" "U" (at 0 0 0))
		(property "Value" "Quad" (at 0 0 0))
		(property "Footprint" "" (at 0 0 0))
		(property "Datasheet" "~" (at 0 0 0))
		(property "Description" "Two-unit part with shared power pins" (at 0 0 0))
		(symbol "Quad_0_1"
			(pin power_in line
				(at 0 7.62 270)
				(length 2.54)
				(name "VCC" (effects (font (size 1 1))))
				(number "8" (effects (font (size 1 1))))
			)
		)
		(symbol "Quad_1_1"
			(rectangle (start -5.08 5.08) (end 5.08 -5.08)
				(stroke (width 0.254) (type default))
				(fill (type background)))
			(pin input line
				(at -7.62 2.54 0)
				(length 2.54)
				(name "A" (effects (font (size 1 1))))
				(number "1" (effects (font (size 1 1))))
			)
			(pin output line
				(at 7.62 2.54 180)
				(length 2.54)
				(name "Y" (effects (font (size 1 1))))
				(number "2" (effects (font (size 1 1))))
			)
		)
		(symbol "Quad_2_1"
			(rectangle (start -5.08 5.08) (end 5.08 -5.08)
				(stroke (width 0.254) (type default))
				(fill (type background)))
			(pin input line
				(at -7.62 2.54 0)
				(length 2.54)
				(name "B" (effects (font (size 1 1))))
				(number "3" (effects (font (size 1 1))))
			)
			(pin output line
				(at 7.62 2.54 180)
				(length 2.54)
				(name "Z" (effects (font (size 1 1))))
				(number "4" (effects (font (size 1 1))))
			)
		)
	)
	(symbol "Quad_B"
		(extends "Quad")
		(property "Reference" "U" (at 0 0 0))
		(property "Value" "Quad_B" (at 0 0 0))
		(property "Description" "Variant of Quad" (at 0 0 0))
	)
	(symbol "Quad_C"
		(extends "Quad_B")
		(property "Reference" "U" (at 0 0 0))
		(property "Value" "Quad_C" (at 0 0 0))
	)
)
